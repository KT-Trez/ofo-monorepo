{
  "name": "@ofo/monorepo",
  "version": "4.0.0",
  "private": true,
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Bartłomiej 'Trez' Wąś"
  },
  "repository": {
    "type": "git",
    "url": "github:KT-Trez/ofo-monorepo"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "codegen": "pnpm --filter @ofo/server-client --filter @ofo/server-contract run generate",
    "dev": "turbo run dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "E2E=1 vitest run",
    "test:integration": "INTEGRATION=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.7.0"
}
