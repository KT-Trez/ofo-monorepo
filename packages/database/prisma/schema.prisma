// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client-desktop {
  provider = "prisma-client"
  output   = "../generated/sqllite"
}

generator client-mobile {
  previewFeatures = ["reactNative"]
  provider        = "prisma-client-js"
  output          = "../generated/react-native"
}

datasource db {
  provider = "sqlite"
}

model Channel {
  // An ID assigned by YouTube
  id           String  @unique
  name         String
  songs        Song[]
  thumbnailUrl String?
  uid          String  @id @default(uuid())
  url          String
}

model Song {
  channel      Channel @relation(fields: [channelUid], references: [uid])
  channelUid   String
  duration     Int
  // An ID assigned by YouTube
  id           String  @unique
  title        String
  thumbnailUrl String?
  uid          String  @id @default(uuid())
}
