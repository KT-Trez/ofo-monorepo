  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@ofo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:codegen"
  }
}
