{
  "name": "@ofo/server-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contract/openapi.yaml --output src/schema.ts",
    "typecheck": "tsc --noEmit"
