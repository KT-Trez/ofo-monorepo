{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "ignorePatterns": ["**/dist/**", "**/drizzle/meta/**", "**/node_modules/**", "**/*.gen.ts"],
  "proseWrap": "always",
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["@ofo/"],
    "newlinesBetween": false
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
