{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "off",
    "pedantic": "off",
    "perf": "error",
    "restriction": "off",
    "style": "off",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**",
    "**/*.gen.ts",
    "packages/server-client/src/schema.ts"
  ],
  "plugins": ["import", "jsdoc", "oxc", "promise", "typescript", "unicorn", "vitest"],
  "overrides": [
    {
      "files": ["**/*.spec.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "rules": {
    "sort-keys": "error",
    "vitest/require-mock-type-parameters": "off"
  }
}
