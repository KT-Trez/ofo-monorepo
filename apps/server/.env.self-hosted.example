# Optional tuning for docker-compose.self-hosted.yml. Copy to ".env" (same directory as the compose
# file) to override the defaults shown here; every line can be left out.

# Host port the API is published on
OFO_PORT=8080
OFO_VERSION=latest

# Parallel download+convert jobs (all clients together); above the limit the server answers 503
MEDIA_MAX_CONCURRENT_DOWNLOADS=3
# How long preparing one file (download + conversion) may take, in seconds
MEDIA_PREPARE_TIMEOUT_SECONDS=300

# Authentication: none | token.
# Generate a token with: openssl rand -hex 32
AUTH_MODE=none
AUTH_TOKEN=
